# Salin berkas ini menjadi .env.development (lokal) lalu isi nilainya.
# Semua variabel VITE_* terlihat oleh pengunjung situs: JANGAN isi rahasia di sini.

# Alamat dasar API backend (tanpa garis miring di akhir)
VITE_API_URL=http://localhost:3000

# Kunci publik widget anti-bot (opsional; kosongkan untuk menonaktifkan)
VITE_TURNSTILE_SITE_KEY=
